#include <stdio.h>

long long int power(int base, int exp) {
    long long int result = 1;
    for(int i = 0; i < exp; i++) {
        result *= base;
    }
    return result;
}

void sortDescending(int arr[], int n) {
    for(int i = 0; i < n - 1; i++) {
        for(int j = i + 1; j < n; j++) {
            if(arr[i] < arr[j]) {
                int temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }
}

int main() {
    int n;
    scanf("%d", &n);

    int a[n]; 

    for(int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    sortDescending(a, n);

    long long int sum = 0;
    for(int i = 0; i < n; i++) {
        sum += (long long)a[i] * power(n, i);
    }

    printf("%lld\n", sum);

    return 0;
}
