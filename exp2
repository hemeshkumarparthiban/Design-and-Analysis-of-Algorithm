#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    int a[n];
    for(int i=0;i<n;i++)
    {
        scanf("%d",&a[i]);
    }
int c=0;
int m=0;
int e=0;
    for(int i=0;i<n;i++)
    {   
        c=0;
        if(a[i]!=-1)
        {
            for(int j=i+1;j<n;j++)
            {
                if(a[i]==a[j])
                {
                    c++;
                    a[j]=-1;
                }
            }
        }
        if(c>m)
        {
            m=c;
            e=a[i];

        }
    }
    printf("%d",e);
}