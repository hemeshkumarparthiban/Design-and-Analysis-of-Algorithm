#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    int a[n];
    for(int i=0;i<n;i++)
    {
        scanf("%d",&a[i]);
    }
    int m;
    scanf("%d",&m);
    int b[m];
    for(int i=0;i<m;i++)
    {
        scanf("%d",&b[i]);
    }
    int c=0;
    int j=0;
   
    while(j<m)
    {
        for(int i=0;i<n;i++)
        {
            
            if(b[i]>=a[j])
            {
                c++;
                j++;
            }
        }
        j++;
        
    }
    printf("%d",c);
}