#include<stdio.h>
int max1(int n)
{
  int a[10]={1,2,5,10,20,50,100,500,1000};
  int r;
  for(int i=0;i<9;i++)
  {
      if(a[i]<=n)
      {
           r=a[i];
      }
      
  }
  return r;
}
int main()
{
  int n;
  scanf("%d",&n);
  int c=0;
  while(n>0){
      int v=max1(n);
      int r=n/v;
      c+=r;
      n=n%v;
  }
  printf("%d",c);
}