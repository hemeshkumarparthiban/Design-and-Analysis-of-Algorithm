#include<stdio.h>
int count=0;

void divide(int a[],int l,int h)
{
    for(int i=l;i<=h;i++)
    
    {
        if(a[i]==0)
        {
            count++;
        }
    }
   
}
int main()
{
    int n;
    scanf("%d",&n);
    int a[n];
    for(int i=0;i<n;i++)
    {
        scanf("%d",&a[i]);
    }
    divide(a,0,n-1);
    printf("%d",count);
}