#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    int a[n];
    for(int i=0;i<n;i++)
    {
        scanf("%d",&a[i]);
    }
    int x,f1=0;
    scanf("%d",&x);
    for(int i=0;i<n;i++)
    {
        int s=0;
        for(int j=i+1;j<n;j++)
        {
            if(a[i]+a[j]==x)
            {
                printf("%d\n",a[i]);
                printf("%d",a[j]);
                f1=1;
                s=1;
                break;
            }
        }
        if(s==1)
        {
            break;
        }
        
    }
    if(f1==0)
    {
        printf("No");
    }
}