#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    while(n>0)
    {
        int n1;
        scanf("%d",&n1);
        int a[n1];
        for(int i=0;i<n1;i++)
        {
            scanf("%d",&a[i]);
        }
         int m;
        scanf("%d",&m);
        int b[m];
        for(int i=0;i<m;i++)
        {
            scanf("%d",&b[i]);
        }
        for(int i=0;i<n1;i++)
        {
            for(int j=0;j<m;j++)
            {
                if(a[i]==b[j])
                {
                    printf("%d ",a[i]);
                    break;
                }
            }
        }
        n--;
    }
}